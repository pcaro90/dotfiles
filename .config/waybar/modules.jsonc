{
  "sway/workspaces": {
    "disable-scroll-wraparound": true,
    "enable-bar-scroll": true,
  },
  "network": {
    "format-ethernet": "󰈀   ↑{bandwidthUpBits} ↓{bandwidthDownBits}",
    "format-wifi": "󰖩   ↑{bandwidthUpBits} ↓{bandwidthDownBits}",
    "interval": 1,
  },
  "cpu": {
    "format": " {usage:3}%",
    "interval": 1,
    "on-click": "sudo /home/pcaro/bin/reset_keyboard.sh",
    "states": {
      "low": 0,
      "medium": 50,
      "high": 80,
    },
  },
  "memory": {
    "format": " {percentage:3}%",
    "states": {
      "low": 0,
      "medium": 50,
      "high": 80,
    },
    "interval": 1,
  },
  "disk#root": {
    "path": "/",
    "format": " {percentage_used:3}%",
    "interval": 30,
    "states": {
      "low": 0,
      "medium": 50,
      "high": 80,
    },
  },
  "disk#storage": {
    "path": "/mnt/Storage",
    "format": " {percentage_used:3}%",
    "interval": 30,
    "states": {
      "low": 0,
      "medium": 50,
      "high": 80,
    },
  },
  "disk#windows": {
    "path": "/mnt/windows",
    "format": "󰨡 {percentage_used:3}%",
    "interval": 30,
    "states": {
      "low": 0,
      "medium": 50,
      "high": 80,
    },
  },
  "clock": {
    "format": "{:%F %a %H:%M}",
  },
  "tray": {
    "icon-size": 20,
    "spacing": 5,
  },
  "battery": {
    "interval": 60,
    "states": {
      "critical": 15,
      "warning": 45,
      "good": 75,
    },
    "format": "{icon}",
    "format-charging": "{icon}",
    "tooltip-format": "{capacity}%",
    "format-icons": {
      "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
      "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
    },
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "󰂲",
    "on-click": "rfkill toggle bluetooth",
    "on-click-right": "blueberry",
    "tooltip-format": "Bluetooth {status}",
    "tooltip-format-connected": "{device_enumerate}",
    "tooltip-format-enumerate-connected": "  {device_alias}",
    "tooltip-format-enumerate-connected-battery": "  {device_alias}  {device_battery_percentage}%",
  },
  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "{icon}",
    "format-icons": {
      "mute": "",
      "default": ["", "", "", ""],
    },
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-click-right": "pavucontrol",
    "tooltip-format": "{volume}% — {desc}",
    "scroll-step": 5,
  },
  "pulseaudio/slider": {
    "orientation": "vertical",
  },
  "custom/swaync": {
    "tooltip": true,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂛",
      "dnd-inhibited-none": "󰪑",
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "on-click-middle": "swaync-client -C -sw",
    "escape": true,
  },
}
